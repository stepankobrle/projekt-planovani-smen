# Připojení k databázi (Transaction mode – pooling)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"

# Přímé připojení k databázi (Session mode – pro migrace)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# JWT
JWT_SECRET="zmen-na-nahodny-dlouhy-retezec"

# SMTP (např. Mailtrap)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# URL frontendu
FRONTEND_URL=http://localhost:3000

# Sentry (volitelné)
SENTRY_DSN=
